{
  "enabledPlugins": {},
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write(**)",
      "Edit(**)",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(grep *)",
      "Bash(tree *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go generate *)",
      "Bash(go mod *)",
      "Bash(go env *)",
      "Bash(go list *)",
      "Bash(go doc *)",
      "Bash(go version)",
      "Bash(go fmt *)",
      "Bash(golangci-lint *)",
      "Bash(npm run *)",
